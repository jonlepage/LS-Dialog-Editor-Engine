{
  "name": "@lsde/dialog-engine-cpp",
  "version": "0.1.0",
  "private": true,
  "description": "Task runner for the C++ LSDE Dialog Engine (requires CMake + C++ compiler)",
  "scripts": {
    "configure": "scripts\\cmake.cmd -B build -DCMAKE_BUILD_TYPE=Debug",
    "build": "scripts\\cmake.cmd --build build",
    "test": "scripts\\ctest.cmd --test-dir build --output-on-failure",
    "playground": "build\\samples\\playground\\Debug\\lsde_playground.exe",
    "clean": "scripts\\cmake.cmd --build build --target clean",
    "rebuild": "npm run configure && npm run build"
  }
}
