            { "uuid": "b1", "type": "DIALOG", "label": "Start", "properties": [], "isStartBlock": true },
            { "uuid": "b2", "type": "DIALOG", "label": "Target A", "properties": [] },
            { "uuid": "b3", "type": "DIALOG", "label": "Target B", "properties": [] }
          ],
          "connections": [
            { "id": "conn-1", "fromId": "b1", "toId": "b2", "fromPort": "out", "toPort": "in" },
