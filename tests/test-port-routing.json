                "choices": [
                  { "uuid": "opt-a", "structureKey": "option_a", "dialogueText": { "en": "Option A" } },
                  { "uuid": "opt-b", "structureKey": "option_b", "dialogueText": { "en": "Option B" } }
                ]
              },
              {
                "uuid": "branch-a",
                "type": "DIALOG",
                "label": "Branch A",
                "properties": [],
                "dialogueText": { "en": "You chose A" }
              },
              {
                "uuid": "branch-b",
                "type": "DIALOG",
                "label": "Branch B",
                "properties": [],
                "dialogueText": { "en": "You chose B" }
              }
            ],
            "connections": [
              {
                "id": "conn-greet-c1",
                "fromId": "greeting",
                "toId": "c1",
                "fromPort": "out",
                "toPort": "in"
              },
              {
                "id": "conn-c1-a",
                "fromId": "c1",
                "toId": "branch-a",
                "fromPort": "opt-a",
                "toPort": "in"
              },
              {
                "id": "conn-c1-b",
                "fromId": "c1",
                "toId": "branch-b",
                "fromPort": "opt-b",
                "toPort": "in"
              }
            ]
          }
        ]
      },
      "sceneId": "scene-3",
      "locale": "en",
      "stateBridge": { "conditions": {}, "dictionaries": {}, "actions": {} },
      "cases": [
        {
          "id": "choice-select-a",
          "description": "Selecting choice opt-a routes to branch-a",
          "steps": [
            { "expect": { "type": "DIALOG", "blockUuid": "greeting" }, "action": { "type": "next" } },
            { "expect": { "type": "CHOICE", "blockUuid": "c1", "visibleChoiceCount": 2 }, "action": { "type": "selectChoice", "choiceUuid": "opt-a" } },
            { "expect": { "type": "DIALOG", "blockUuid": "branch-a" }, "action": { "type": "next" } },
            { "expect": { "type": "END_OF_SCENE" } }
          ],
          "expectedVisited": ["greeting", "c1", "branch-a"],
          "expectedCleanupCalls": 3
        },
        {
          "id": "choice-select-b",
          "description": "Selecting choice opt-b routes to branch-b",
          "steps": [
            { "expect": { "type": "DIALOG", "blockUuid": "greeting" }, "action": { "type": "next" } },
            { "expect": { "type": "CHOICE", "blockUuid": "c1", "visibleChoiceCount": 2 }, "action": { "type": "selectChoice", "choiceUuid": "opt-b" } },
            { "expect": { "type": "DIALOG", "blockUuid": "branch-b" }, "action": { "type": "next" } },
            { "expect": { "type": "END_OF_SCENE" } }
          ],
